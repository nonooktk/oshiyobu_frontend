{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push *HEAD)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push *:refs/heads/dev*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--tags*)",
      "Bash(git reset *--hard*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout *--force*)",
      "Bash(git switch -f*)",
      "Bash(git switch *--force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh release *)",
      "Bash(az *)",
      "Bash(azd *)",
      "Bash(swa *)",
      "Bash(npx swa *)",
      "Bash(npx @azure/static-web-apps-cli *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(npm run core:sync *)",
      "Bash(node scripts/core-sync.mjs *)",
      "PowerShell(git -C *)",
      "PowerShell(git -c *)",
      "PowerShell(git push)",
      "PowerShell(git push origin)",
      "PowerShell(git push *HEAD)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push * dev)",
      "PowerShell(git push * dev *)",
      "PowerShell(git push *:dev)",
      "PowerShell(git push *:dev *)",
      "PowerShell(git push *:refs/heads/dev*)",
      "PowerShell(git push *:refs/heads/main*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--tags*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git checkout -f*)",
      "PowerShell(git checkout * -f*)",
      "PowerShell(git checkout *--force*)",
      "PowerShell(git switch -f*)",
      "PowerShell(git switch *--force*)",
      "PowerShell(git switch *--discard-changes*)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh api *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(gh release *)",
      "PowerShell(az *)",
      "PowerShell(azd *)",
      "PowerShell(swa *)",
      "PowerShell(npx swa *)",
      "PowerShell(npx @azure/static-web-apps-cli *)",
      "PowerShell(vercel *)",
      "PowerShell(netlify *)",
      "PowerShell(npm run core:sync *)",
      "PowerShell(node scripts/core-sync.mjs *)",
      "Edit(/src/core/**)",
      "Edit(/core.lock.json)",
      "Edit(/.github/**)",
      "Edit(/public/staticwebapp.config.json)",
      "Edit(/docs/守ること.md)",
      "Edit(/tests/guard/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/scripts/claude-brief.mjs)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/claude-brief.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
