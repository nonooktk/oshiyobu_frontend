# 秘匿値（絶対にコミットしない。.env の値を編集するのは統括だけ）
.env
.env.*
*.env
!.env.example

# 鍵・証明書
*.pem
*.pfx
*.key

# Azure CLI / azd のローカル設定
.azure/

# 依存パッケージ
node_modules/

